# Kotlin text multifile facade classes have package-private superclass relationships.
# Preserve this package while still allowing class/member obfuscation, shrinking and optimization.
# This avoids the IllegalAccessError seen after repackaging these classes out of kotlin.text.
-keeppackagenames kotlin.text

# Gson reflects over API request/response models, including DTOs without @SerializedName.
# Keep their classes, constructors and members so JSON field names and reflective access stay stable.
-keep class com.oniolla.interviewer.data.model.** { *; }
-keep class com.oniolla.interviewer.data.payload.** { *; }
-keep class com.oniolla.interviewer.data.CustomError { *; }

# Preserve generic field types and Gson annotations used by the API models.
-keepattributes Signature,RuntimeVisibleAnnotations,AnnotationDefault

# Retain source file names and line numbers for readable Crashlytics stack traces.
-keepattributes SourceFile,LineNumberTable

# OkHttp, Retrofit, Gson, Hilt, Room and coroutines supply their own consumer rules.
# The rest of the application and those libraries remain eligible for R8 optimization.
